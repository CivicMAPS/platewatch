# PlateWatch backend (docs/BACKEND.md). Copy to .env for `npm run server`; never commit .env.
DATABASE_URL=postgres://platewatch:platewatch@localhost:5432/platewatch
# Long random strings, different from each other (e.g. `openssl rand -base64 33`).
PLATEWATCH_DEVICE_TOKEN=
PLATEWATCH_CONSOLE_TOKEN=
PLATEWATCH_COUNCIL=com
PLATEWATCH_CORS_ORIGINS=*
PLATEWATCH_TIMEZONE=Australia/Melbourne
PLATEWATCH_DEFAULT_BRANCH=parking
# Hot-list pop-up: seconds to answer before the soft Code 1 (DECISION REQUIRED, BE-4).
PLATEWATCH_HOT_ACK_SECONDS=60
PLATEWATCH_WATCHDOG_GRACE_SECONDS=20
# 0 = dispatch escalates manually when there is no radio response.
PLATEWATCH_RADIO_ESCALATE_SECONDS=0
PORT=8787
