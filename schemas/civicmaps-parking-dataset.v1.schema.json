{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civicmaps.au/schemas/civicmaps-parking-dataset.v1.schema.json",
  "title": "civicmaps.parking_dataset v1",
  "description": "Normalised street segment and parking data, identical in structure for every council: every record carries every key, with null or [] where a value is unknown or not yet acquired. Council data is adapted to this structure. Segment \u2192 sides \u2192 parts \u2192 payment, permit area, restrictions and bays. Identifiers: <council code>-<road_segment_id> (provisional <code>-<road>-<from>-<to> until the asset ID is known). See docs/PARKING-DATA-SCHEMA.md.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "dataset",
    "conventions",
    "patrol_zones",
    "permit_areas",
    "segments"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "civicmaps.parking_dataset"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "dataset": {
      "$ref": "#/$defs/datasetInfo"
    },
    "conventions": {
      "$ref": "#/$defs/conventions"
    },
    "patrol_zones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patrolZone"
      }
    },
    "permit_areas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/permitArea"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "hhmm": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$|^24:00$"
    },
    "latLng": {
      "type": "object",
      "description": "WGS84 position.",
      "required": [
        "lat",
        "lng"
      ],
      "additionalProperties": false,
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "dataQuality": {
      "type": "object",
      "required": [
        "status",
        "source",
        "confidence",
        "last_verified",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "verified",
            "field_checked",
            "unverified",
            "inferred",
            "pending_field_capture"
          ]
        },
        "source": {
          "$ref": "#/$defs/nullableString"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            null
          ]
        },
        "last_verified": {
          "$ref": "#/$defs/date"
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "name",
        "publisher",
        "url",
        "format",
        "reference_date",
        "data_used",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "publisher": {
          "$ref": "#/$defs/nullableString"
        },
        "url": {
          "$ref": "#/$defs/nullableString"
        },
        "format": {
          "$ref": "#/$defs/nullableString"
        },
        "reference_date": {
          "$ref": "#/$defs/nullableString"
        },
        "data_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "datasetInfo": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "generated_at",
        "municipality",
        "sources",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable identifier; part of every list's external ID."
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "in_review",
            "enforcement_ready",
            "superseded"
          ]
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "municipality": {
          "type": "object",
          "required": [
            "name",
            "code",
            "state",
            "country",
            "timezone"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "code": {
              "type": "string",
              "pattern": "^[a-z0-9]+$",
              "description": "Council code used in every identifier, lower case: com (City of Melbourne), copp (City of Port Phillip)."
            },
            "state": {
              "$ref": "#/$defs/nullableString"
            },
            "country": {
              "$ref": "#/$defs/nullableString"
            },
            "timezone": {
              "type": "string",
              "description": "IANA zone in which restriction times apply, e.g. Australia/Melbourne."
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bay_sign_format": {
          "type": [
            "string",
            "null"
          ],
          "description": "How kerb bay plates are numbered: {parking_area}, {easypark_area} and {bay} placeholders, e.g. \"{parking_area}{bay}\" (City of Melbourne: area 645 + bay 58 = 64558). Null when the council has no numbered bay plates."
        },
        "paystay_zone_pattern": {
          "$ref": "#/$defs/nullableString"
        },
        "easypark_area_pattern": {
          "$ref": "#/$defs/nullableString"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "bay_sign_format",
        "paystay_zone_pattern",
        "easypark_area_pattern",
        "notes"
      ]
    },
    "patrolZone": {
      "type": "object",
      "required": [
        "id",
        "number",
        "name",
        "kind",
        "geometry"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[a-z0-9-]+$",
          "description": "<council code>-<number or name>, e.g. copp-10, com-chinatown."
        },
        "number": {
          "$ref": "#/$defs/nullableString",
          "description": "Internal patrol zone / enforcement area number, e.g. \"10\"."
        },
        "name": {
          "$ref": "#/$defs/nullableString",
          "description": "Operational name used day to day, e.g. \"Flagstaff\"."
        },
        "kind": {
          "enum": [
            "patrol_area",
            "enforcement_zone",
            "precinct"
          ]
        },
        "geometry": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "permitArea": {
      "type": "object",
      "required": [
        "id",
        "code",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+-rpa-[a-z0-9-]+$",
          "description": "<council code>-rpa-<code>, e.g. copp-rpa-7."
        },
        "code": {
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "bound": {
      "type": "object",
      "description": "One end of a part: an intersection, the segment end, a bay, an address, a point or a boundary.",
      "required": [
        "kind",
        "label",
        "location"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "intersection",
            "segment_end",
            "bay",
            "address",
            "point",
            "boundary"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "oneOf": [
            {
              "$ref": "#/$defs/latLng"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parking_area": {
          "$ref": "#/$defs/nullableString",
          "description": "Council parking area number (one per segment), e.g. City of Melbourne \"645\"."
        },
        "easypark_areas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paystay_zones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "zone",
              "meter_id"
            ],
            "additionalProperties": false,
            "properties": {
              "zone": {
                "type": "string",
                "minLength": 1
              },
              "meter_id": {
                "$ref": "#/$defs/nullableString"
              }
            }
          }
        },
        "meters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "location"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "location": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/latLng"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "required": [
        "parking_area",
        "easypark_areas",
        "paystay_zones",
        "meters"
      ]
    },
    "restriction": {
      "type": "object",
      "required": [
        "control",
        "sign_code",
        "limit_minutes",
        "days",
        "all_day",
        "start",
        "end",
        "public_holidays",
        "exceptions",
        "exempt_permit_areas",
        "grace_minutes",
        "source_sign_id",
        "effective_from",
        "effective_to",
        "data_quality"
      ],
      "additionalProperties": false,
      "properties": {
        "control": {
          "enum": [
            "time_limit",
            "metered",
            "ticket",
            "loading_zone",
            "permit_zone",
            "no_stopping",
            "no_parking",
            "clearway",
            "bus_zone",
            "taxi_zone",
            "accessible",
            "works_zone",
            "other"
          ]
        },
        "sign_code": {
          "$ref": "#/$defs/nullableString",
          "description": "As printed: 2P, 1/2P, P15, LZ 30."
        },
        "limit_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1440
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          }
        },
        "all_day": {
          "type": "boolean"
        },
        "start": {
          "$ref": "#/$defs/hhmm"
        },
        "end": {
          "$ref": "#/$defs/hhmm"
        },
        "public_holidays": {
          "enum": [
            "applies",
            "excluded",
            null
          ]
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exempt_permit_areas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "grace_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 120
        },
        "source_sign_id": {
          "$ref": "#/$defs/nullableString"
        },
        "effective_from": {
          "$ref": "#/$defs/date"
        },
        "effective_to": {
          "$ref": "#/$defs/date"
        },
        "data_quality": {
          "$ref": "#/$defs/dataQuality"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "all_day": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "start": {
                "type": "null"
              },
              "end": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "control": {
                "enum": [
                  "time_limit",
                  "metered",
                  "ticket"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "limit_minutes": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "bay": {
      "type": "object",
      "required": [
        "number",
        "sign_number",
        "location",
        "kind",
        "data_quality",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 0
        },
        "sign_number": {
          "$ref": "#/$defs/nullableString",
          "description": "Kerb plate number, when not given by conventions.bay_sign_format."
        },
        "location": {
          "oneOf": [
            {
              "$ref": "#/$defs/latLng"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "standard",
            "accessible",
            "loading",
            "motorcycle",
            "ev",
            "other",
            null
          ]
        },
        "data_quality": {
          "$ref": "#/$defs/dataQuality"
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "part": {
      "type": "object",
      "description": "The whole side (no from/to) or the stretch of it between two bounds where the signs change.",
      "required": [
        "id",
        "from",
        "to",
        "permit_area",
        "payment",
        "restrictions_status",
        "restrictions",
        "bays",
        "data_quality",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique within its side: \"all\" for the whole side, otherwise from the bounds, e.g. \"bay-58-bay-72\"."
        },
        "from": {
          "oneOf": [
            {
              "$ref": "#/$defs/bound"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when the part is the whole side."
        },
        "to": {
          "oneOf": [
            {
              "$ref": "#/$defs/bound"
            },
            {
              "type": "null"
            }
          ]
        },
        "permit_area": {
          "$ref": "#/$defs/nullableString"
        },
        "payment": {
          "$ref": "#/$defs/payment"
        },
        "restrictions_status": {
          "enum": [
            "supplied",
            "pending_field_capture",
            "no_parking_spaces"
          ]
        },
        "restrictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/restriction"
          }
        },
        "bays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bay"
          }
        },
        "data_quality": {
          "$ref": "#/$defs/dataQuality"
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "side": {
      "type": "object",
      "required": [
        "side",
        "parts"
      ],
      "additionalProperties": false,
      "properties": {
        "side": {
          "enum": [
            "both",
            "north",
            "south",
            "east",
            "west",
            "odd",
            "even"
          ]
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/part"
          }
        }
      }
    },
    "geometry": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "additionalProperties": true,
          "properties": {
            "type": {
              "enum": [
                "LineString",
                "MultiLineString"
              ]
            },
            "coordinates": {
              "type": "array"
            }
          }
        }
      ]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "road_segment_id",
        "patrol_zone",
        "road",
        "between",
        "geometry",
        "sides",
        "data_quality",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+-[a-z0-9-]+$",
          "description": "<council code>-<road_segment_id>, e.g. copp-31065, com-20055. Provisional <code>-<road>-<from>-<to> until the asset ID is known."
        },
        "road_segment_id": {
          "$ref": "#/$defs/nullableString",
          "description": "The council's road segment asset ID (also called road segment asset ID or corridor ID), e.g. City of Melbourne 20055. Null until acquired."
        },
        "patrol_zone": {
          "$ref": "#/$defs/nullableString",
          "description": "patrol_zones[].id"
        },
        "road": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "locality",
            "external_ids"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "locality": {
              "$ref": "#/$defs/nullableString"
            },
            "external_ids": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Other references, e.g. {\"source_segment_id\": \"\u2026\", \"vicmap_ufi\": \"\u2026\"}; {} when none."
            }
          }
        },
        "between": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "sides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/side"
          }
        },
        "data_quality": {
          "$ref": "#/$defs/dataQuality"
        },
        "notes": {
          "$ref": "#/$defs/nullableString"
        }
      }
    }
  }
}
