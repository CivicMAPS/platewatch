  "field_definitions": {
    "segment_id": "Locally assigned identifier for the working road segment.",
    "enforcement_zone": "Authoritative operational parking-enforcement zone. Null until verified.",
    "enforcement_zone_candidates": "Possible zones based on the stated scope, not an authoritative assignment.",
    "road_segment_name": "Road containing the parking-control segment.",
    "between_street_name": "Cross street or visible map boundary at the beginning of the segment.",
    "and_street_name": "Cross street or visible map boundary at the end of the segment.",
    "road_side": "Side of the road to which the restriction applies: north, south, east, west or both.",
    "parking_restrictions": "One or more parking controls applying to the segment.",
    "applicable_days": "Explicit days on which the parking restriction operates.",
    "applicable_times": "Local start and end times in 24-hour HH:MM format.",
    "restriction_applied": "Signed restriction, such as No Stopping, Loading Zone, 1P, 2P, Metered Parking or Permit Zone.",
    "permit_or_vehicle_exceptions": "Any permit, vehicle-class or activity exceptions shown on the authoritative sign.",
    "source_sign_or_asset_id": "Council sign, parking-control or asset identifier supporting the restriction.",
    "effective_from": "Date from which the restriction is effective.",
    "effective_to": "Date on which the restriction ceases, if applicable.",
    "verification_status": "Whether the restriction has been verified against an authoritative source.",
    "geometry": "Authoritative GeoJSON LineString or MultiLineString for the controlled kerb section."
  },
