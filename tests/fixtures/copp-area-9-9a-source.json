    ],
    "important_distinction": "Parking enforcement zones are not residential parking permit areas."
  },
  "schema_notes": {
    "segment_granularity": "One record per road section. Split into separate road-side records when authoritative kerb data becomes available.",
    "multiple_controls": "Add one parking_restrictions object for every distinct day, time and control combination.",
    "null_policy": "Null and empty values mean the information was not available from accessible sources and has not been guessed.",
    "colour_policy": "Coloured lines in the screenshot have not been translated into restrictions because no legend or authoritative mapping was available."
  },
